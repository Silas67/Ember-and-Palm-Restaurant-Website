{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "buildCommand": "pnpm run build"
    },
    "ember-palm": {
      "root": "artifacts/ember-palm",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist/public"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "ember-palm"
      }
    }
  ]
}